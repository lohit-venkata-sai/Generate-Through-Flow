# Copy to server/.env and fill in — never commit .env
PORT=3001
# Extension origin(s) allowed to call the API (comma-separated).
# Find yours at chrome://extensions → Generate Through Flow → ID.
# Empty = allow all (local dev only, never in production).
CLIENT_ORIGIN=chrome-extension://your-extension-id
GOOGLE_CLIENT_ID=1064543963079-34muhr16ctumlcf5kmk37b6abgjop3af.apps.googleusercontent.com

# From Supabase dashboard → Project Settings → API
# (project ref rvlmfodwbtuwcjnkvbiv)
SUPABASE_URL=https://rvlmfodwbtuwcjnkvbiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[paste-service_role-key-here]

# Razorpay (test keys are fine for development)
# Dashboard → Settings → API Keys for KEY_ID / KEY_SECRET.
# Dashboard → Settings → Webhooks → Add webhook → secret goes below.
RAZORPAY_KEY_ID=[paste-razorpay-key-id-here]
RAZORPAY_KEY_SECRET=[paste-razorpay-key-secret-here]
RAZORPAY_WEBHOOK_SECRET=[paste-webhook-secret-here]
# Currency for payment links (account must support it; test accounts: INR always, USD if enabled)
BILLING_CURRENCY=USD
