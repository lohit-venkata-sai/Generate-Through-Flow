# Copy to server/.env and fill in — never commit .env
PORT=3001
# Extension origin(s) allowed to call the API (comma-separated).
# Find yours at chrome://extensions → Generate Through Flow → ID.
# Empty = allow all (local dev only, never in production).
CLIENT_ORIGIN=chrome-extension://your-extension-id
GOOGLE_CLIENT_ID=1064543963079-34muhr16ctumlcf5kmk37b6abgjop3af.apps.googleusercontent.com

# From Supabase dashboard → Project Settings → API
# (project ref rvlmfodwbtuwcjnkvbiv)
SUPABASE_URL=https://rvlmfodwbtuwcjnkvbiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[paste-service_role-key-here]

# DodoPayments (test keys are fine for development)
# Dashboard → Developer → API Keys for the test secret key.
# Dashboard → Developer → Webhooks → endpoint secret goes below.
# Env defaults to test_mode; set live_mode only with live keys.
DODO_PAYMENTS_API_KEY=[paste-dodo-api-key-here]
DODO_PAYMENTS_WEBHOOK_KEY=[paste-webhook-signing-secret-here]
DODO_PAYMENTS_ENV=test_mode
# Product ids have built-in defaults (see server/src/lib/billing.ts);
# set these only to override without a code change.
# DODO_PRODUCT_P3=
# DODO_PRODUCT_P4=
# DODO_PRODUCT_P5=
# DODO_PRODUCT_P7=
# DODO_PRODUCT_P10=
# DODO_PRODUCT_P3_TO_P4=
# DODO_PRODUCT_P3_TO_P5=
# DODO_PRODUCT_P4_TO_P5=
# DODO_PRODUCT_RENEW_6MO=
