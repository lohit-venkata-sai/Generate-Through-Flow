# server/.env template — copy to server/.env and fill in. NEVER commit .env.
#
# Two setups live in ONE file, switched by DODO_PAYMENTS_ENV:
#   test section active  → local development (DODO_PAYMENTS_ENV=test_mode)
#   prod section active  → comment out test values, uncomment prod values,
#                          set DODO_PAYMENTS_ENV=live_mode
# Better: use this file for local dev, and your host's env dashboard
# (Render/Railway/Fly → Environment) for production — nothing to copy.

PORT=3001

# --- Extension origin(s) allowed to call the API (comma-separated) ---
# Local: chrome://extensions → Generate Through Flow → ID.
# Prod: the Chrome Web Store listing ID (only known after first publish).
# Empty = allow all (local dev only, never in production).
CLIENT_ORIGIN=chrome-extension://your-extension-id
# PROD: CLIENT_ORIGIN=chrome-extension://<web-store-extension-id>

GOOGLE_CLIENT_ID=1064543963079-34muhr16ctumlcf5kmk37b6abgjop3af.apps.googleusercontent.com

# --- Supabase (same project works for test + prod) ---
# Dashboard → Project Settings → API (project ref rvlmfodwbtuwcjnkvbiv)
SUPABASE_URL=https://rvlmfodwbtuwcjnkvbiv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[paste-service_role-key-here]

# --- DodoPayments: TEST ---
# Dashboard (test mode) → Developer → API Keys / Webhooks.
DODO_PAYMENTS_API_KEY=[paste-dodo-test-api-key-here]
DODO_PAYMENTS_WEBHOOK_KEY=[paste-test-webhook-signing-secret-here]
DODO_PAYMENTS_ENV=test_mode

# --- DodoPayments: PROD (comment in when going live) ---
# Dashboard (LIVE mode) → separate API key + separate webhook endpoint
# pointing at https://<your-prod-server>/api/billing/webhook.
# DODO_PAYMENTS_API_KEY=[paste-dodo-LIVE-api-key-here]
# DODO_PAYMENTS_WEBHOOK_KEY=[paste-LIVE-webhook-signing-secret-here]
# DODO_PAYMENTS_ENV=live_mode

# Product ids have built-in defaults (see server/src/lib/billing.ts);
# set these only to override without a code change.
# DODO_PRODUCT_P3=
# DODO_PRODUCT_P4=
# DODO_PRODUCT_P5=
# DODO_PRODUCT_P7=
# DODO_PRODUCT_P10=
# DODO_PRODUCT_P3_TO_P4=
# DODO_PRODUCT_P3_TO_P5=
# DODO_PRODUCT_P4_TO_P5=
# DODO_PRODUCT_RENEW_6MO=
